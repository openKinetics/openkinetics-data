DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=data.openkinetics.org,10.1.2.12,localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=https://data.openkinetics.org
CORS_ALLOWED_ORIGINS=https://data.openkinetics.org

SQLITE_PATH=/data/runtime/db.sqlite3
OPENKINETICS_RELEASES_ROOT=/data/releases
OPENKINETICS_RELEASES_URL_BASE=/releases
OPENKINETICS_SEQUENCE_INFO_ROOT=/sequence_info

OPENKINETICS_ESM2_RESIDUE_ROOT=esm2_layer_26/residue_vecs
OPENKINETICS_ESMC_RESIDUE_ROOT=esmc_layer_32/residue_vecs
OPENKINETICS_PROT_T5_RESIDUE_ROOT=prot_t5_layer_19/residue_vecs
OPENKINETICS_PSEQ2SITES_ROOT=pseq2sites_scores

# Production can set this to 10.1.2.12:8082 so only the private interface is exposed.
OPENKINETICS_FRONTEND_BIND=8082
